:root {
  color: #17191e;
  background: #f6f7f9;
  font-family: Inter, Pretendard, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* { box-sizing: border-box; }
body { margin: 0; min-width: 320px; }
a { color: inherit; text-decoration: none; }
button, input { font: inherit; }
button { cursor: pointer; }

.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
.header { background: #fff; border-bottom: 1px solid #e3e6eb; }
.header-inner { display: flex; align-items: center; justify-content: space-between; max-width: 1200px; height: 64px; padding: 0 40px; margin: 0 auto; }
.header-left, .header-right, .header-nav, .logo { display: flex; align-items: center; }
.header-left { gap: 40px; }
.header-right { gap: 12px; }
.logo { gap: 7px; font-size: 18px; font-weight: 800; }
.logo img { width: 22px; height: 22px; }
.header-nav { gap: 28px; font-size: 14px; color: #606774; }
.header-nav a:hover, .header-nav .active { color: #2563eb; font-weight: 700; }
.search-button { display: grid; width: 36px; height: 36px; place-items: center; border: 1px solid #e3e6eb; border-radius: 6px; background: #fff; }
.search-button img { width: 19px; height: 19px; }
.login-button { height: 36px; padding: 0 16px; border: 0; border-radius: 6px; background: #2563eb; color: #fff; }
.login-button:hover { background: #1d4ed8; }

.main-content { max-width: 1100px; padding: 32px 40px 80px; margin: 0 auto; }
.main-content h1, .movie-detail h1 { margin: 0 0 24px; font-size: 28px; line-height: 1.25; }
.movie-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 28px 16px; }
.movie-card { min-width: 0; }
.poster-wrapper { position: relative; }
.movie-poster { display: block; width: 100%; aspect-ratio: 2 / 3; object-fit: cover; border-radius: 8px; background: #e3e6eb; }
.bookmark-button { position: absolute; top: 8px; right: 8px; display: grid; width: 32px; height: 32px; padding: 0; place-items: center; border: 0; border-radius: 8px; background: #fff; box-shadow: 0 2px 8px rgb(23 25 30 / 12%); }
.bookmark-button img { width: 20px; height: 20px; }
.movie-title { margin: 9px 0 0; font-size: 14px; line-height: 1.4; }
.movie-title a:hover { color: #2563eb; }
.movie-release-date { margin: 4px 0 0; font-size: 12px; color: #969da8; }
.pagination { display: flex; justify-content: center; gap: 8px; margin-top: 40px; }
.pagination button { min-width: 36px; height: 36px; border: 1px solid #e3e6eb; border-radius: 6px; background: #fff; color: #17191e; }
.pagination button:hover { border-color: #2563eb; }
.pagination .active { border-color: #2563eb; background: #2563eb; color: #fff; }

.search-field { display: flex; align-items: center; max-width: 560px; gap: 10px; padding: 0 14px; border: 1px solid #cbd1d9; border-radius: 8px; background: #fff; }
.search-field:focus-within { border-color: #2563eb; box-shadow: 0 0 0 3px rgb(37 99 235 / 12%); }
.search-field img { width: 20px; height: 20px; }
.search-field input { width: 100%; height: 48px; border: 0; outline: 0; }
.search-result { margin: 18px 0; font-size: 14px; color: #606774; }
.empty-state { color: #606774; text-align: center; padding: 48px 0; }

.movie-detail { position: relative; min-height: calc(100vh - 64px); overflow: hidden; background: #131722; color: #fff; }
.movie-backdrop { position: absolute; inset: 0; background-position: center top; background-size: cover; opacity: .26; }
.movie-backdrop::after { position: absolute; inset: 0; content: ""; background: linear-gradient(90deg, #131722 0%, rgb(19 23 34 / 78%) 55%, rgb(19 23 34 / 56%)); }
.movie-detail-content { position: relative; max-width: 1100px; padding: 40px; margin: 0 auto; }
.back-link { display: inline-block; margin-bottom: 28px; color: #dfe6ff; font-size: 14px; }
.back-link:hover { color: #fff; text-decoration: underline; }
.movie-detail-summary { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 40px; align-items: start; }
.detail-poster { width: 100%; border-radius: 10px; box-shadow: 0 10px 30px rgb(0 0 0 / 30%); }
.movie-detail h1 { margin-bottom: 5px; font-size: clamp(32px, 5vw, 48px); }
.eyebrow, .original-title { margin: 0; color: #c9d0df; }
.tagline { margin: 26px 0 18px; font-size: 18px; font-weight: 600; }
.genre-list { display: flex; flex-wrap: wrap; gap: 8px; }
.genre-list span { padding: 6px 10px; border-radius: 999px; background: rgb(255 255 255 / 16%); font-size: 13px; }
.overview { max-width: 650px; margin: 24px 0 0; line-height: 1.7; color: #edf0f7; }

@media (max-width: 700px) {
  .header-inner { height: 58px; padding: 0 20px; }
  .header-left { gap: 20px; }
  .header-nav { gap: 14px; }
  .header-nav a:last-child, .login-button { display: none; }
  .main-content { padding: 24px 20px 60px; }
  .movie-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 12px; }
  .movie-detail-content { padding: 28px 20px; }
  .movie-detail-summary { grid-template-columns: 120px minmax(0, 1fr); gap: 20px; }
  .tagline { margin-top: 16px; }
}
